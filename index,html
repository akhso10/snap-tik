    <script>
        // ====== GLOBAL STATE ======
        let currentVideoData = null;
        let downloadCount = parseInt(localStorage.getItem('totalDownloads') || '0');
        let isDarkTheme = localStorage.getItem('theme') !== 'light';

        // ====== INITIALIZATION ======
        document.addEventListener('DOMContentLoaded', () => {
            // Preloader
            setTimeout(() => {
                document.getElementById('preloader').classList.add('hide');
            }, 1200);

            // Set year
            document.getElementById('footerYear').textContent = new Date().getFullYear();

            // Update download count
            updateDownloadCount();

            // Load history
            renderHistory();

            // Apply theme
            applyTheme();

            // Auto-detect clipboard
            autoDetectClipboard();

            // Placeholder rotation
            rotatePlaceholder();
        });

        // ====== THEME ======
        function applyTheme() {
            document.documentElement.setAttribute('data-theme', isDarkTheme ? 'dark' : 'light');
            const icon = document.querySelector('#themeBtn i');
            icon.className = isDarkTheme ? 'fas fa-moon' : 'fas fa-sun';
        }

        document.getElementById('themeBtn').addEventListener('click', () => {
            isDarkTheme = !isDarkTheme;
            localStorage.setItem('theme', isDarkTheme ? 'dark' : 'light');
            applyTheme();
            showToast('info', 'Tema Diubah', isDarkTheme ? 'Mode gelap aktif' : 'Mode terang aktif');
        });

        // ====== PAGE NAVIGATION ======
        function showPage(page) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.getElementById(`page-${page}`).classList.add('active');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ====== TOAST NOTIFICATION SYSTEM ======
        function showToast(type, title, message, duration = 4000) {
            const container = document.getElementById('toastContainer');
            const icons = {
                success: 'fa-check',
                error: 'fa-xmark',
                warning: 'fa-exclamation',
                info: 'fa-info',
                download: 'fa-download'
            };

            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `
                <div class="toast-icon"><i class="fas ${icons[type]}"></i></div>
                <div class="toast-content">
                    <h4>${title}</h4>
                    <p>${message}</p>
                </div>
                <button class="toast-close" onclick="removeToast(this.parentElement)">
                    <i class="fas fa-xmark"></i>
                </button>
            `;

            container.appendChild(toast);

            setTimeout(() => removeToast(toast), duration);
        }

        function removeToast(toast) {
            if (!toast || toast.classList.contains('removing')) return;
            toast.classList.add('removing');
            setTimeout(() => toast.remove(), 300);
        }

        // ====== DOWNLOAD NOTIFICATION ======
        function showDownloadNotification(fileName, fileType, thumbUrl) {
            // Remove existing notification
            const existing = document.querySelector('.download-notification');
            if (existing) existing.remove();

            const notif = document.createElement('div');
            notif.className = 'download-notification';
            notif.innerHTML = `
                <div class="download-notif-header">
                    <div class="dn-icon"><i class="fas fa-download"></i></div>
                    <div class="dn-info">
                        <h4>Downloading...</h4>
                        <span>Mohon tunggu sebentar</span>
                    </div>
                </div>
                <div class="download-notif-body">
                    <div class="file-info">
                        <div class="file-thumb">
                            <img src="${thumbUrl || ''}" alt="" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect fill=%22%23333%22 width=%22100%22 height=%22100%22/><text x=%2250%22 y=%2255%22 text-anchor=%22middle%22 fill=%22%23666%22 font-size=%2230%22>🎬</text></svg>'">
                        </div>
                        <div class="file-details">
                            <h5>${fileName}</h5>
                            <span>${fileType} • Memulai download...</span>
                        </div>
                    </div>
                    <div class="download-progress">
                        <div class="download-progress-bar" id="dnProgressBar"></div>
                    </div>
                    <div class="download-progress-text">
                        <span id="dnPercent">0%</span>
                        <span id="dnStatus">Memproses...</span>
                    </div>
                </div>
                <div class="download-notif-footer">
                    <button class="dn-btn secondary" onclick="cancelDownload(this)">Batal</button>
                    <button class="dn-btn primary" onclick="openFileLocation(this)">Buka File</button>
                </div>
            `;

            document.body.appendChild(notif);

            // Simulate download progress
            simulateDownloadProgress(notif);
        }

        function simulateDownloadProgress(notif) {
            let progress = 0;
            const progressBar = notif.querySelector('#dnProgressBar');
            const percentText = notif.querySelector('#dnPercent');
            const statusText = notif.querySelector('#dnStatus');
            const header = notif.querySelector('.dn-info h4');

            const interval = setInterval(() => {
                progress += Math.random() * 15 + 5;
                if (progress >= 100) {
                    progress = 100;
                    clearInterval(interval);
                    
                    progressBar.style.width = '100%';
                    percentText.textContent = '100%';
                    statusText.textContent = 'Selesai!';
                    header.textContent = 'Download Selesai! ✓';
                    
                    // Change icon to success
                    const icon = notif.querySelector('.dn-icon');
                    icon.style.background = 'var(--success)';
                    icon.innerHTML = '<i class="fas fa-check"></i>';

                    // Show success toast
                    showToast('success', 'Download Selesai!', 'File berhasil disimpan ke perangkatmu');

                    // Auto hide after 5 seconds
                    setTimeout(() => {
                        notif.classList.add('hiding');
                        setTimeout(() => notif.remove(), 300);
                    }, 5000);
                } else {
                    progressBar.style.width = `${progress}%`;
                    percentText.textContent = `${Math.round(progress)}%`;
                    
                    if (progress < 30) statusText.textContent = 'Mengunduh...';
                    else if (progress < 60) statusText.textContent = 'Memproses file...';
                    else if (progress < 90) statusText.textContent = 'Hampir selesai...';
                    else statusText.textContent = 'Menyimpan file...';
                }
            }, 300);

            // Store interval for cancel
            notif.dataset.interval = interval;
        }

        function cancelDownload(btn) {
            const notif = btn.closest('.download-notification');
            const interval = parseInt(notif.dataset.interval);
            clearInterval(interval);
            notif.classList.add('hiding');
            setTimeout(() => notif.remove(), 300);
            showToast('warning', 'Download Dibatalkan', 'Download telah dibatalkan');
        }

        function openFileLocation(btn) {
            showToast('info', 'Info', 'File tersimpan di folder Downloads perangkatmu');
        }

        // ====== CLIPBOARD & INPUT ======
        document.getElementById('pasteBtn').addEventListener('click', async () => {
            try {
                const text = await navigator.clipboard.readText();
                document.getElementById('urlInput').value = text;
                showToast('success', 'Berhasil Paste', 'Link berhasil ditempel dari clipboard');
                
                // Auto-process if valid TikTok URL
                if (isTikTokUrl(text)) {
                    setTimeout(() => processTikTokLink(), 500);
                }
            } catch (err) {
                showToast('error', 'Gagal Paste', 'Izinkan akses clipboard atau paste manual');
            }
        });

        document.getElementById('clearBtn').addEventListener('click', () => {
            document.getElementById('urlInput').value = '';
            document.getElementById('errorState').classList.remove('active');
            document.getElementById('urlInput').focus();
        });

        async function autoDetectClipboard() {
            // Try to detect TikTok URL in clipboard on page load
            try {
                if (navigator.clipboard && navigator.clipboard.readText) {
                    const text = await navigator.clipboard.readText();
                    if (isTikTokUrl(text) && !document.getElementById('urlInput').value) {
                        document.getElementById('urlInput').value = text;
                        showToast('info', 'Link Terdeteksi', 'Link TikTok terdeteksi dari clipboard. Klik Download untuk memproses.');
                    }
                }
            } catch (e) {
                // Clipboard access denied, that's okay
            }
        }

        function isTikTokUrl(url) {
            return /tiktok\.com|vm\.tiktok\.com|vt\.tiktok\.com/i.test(url);
        }

        // ====== PROCESS LINK ======
        document.getElementById('processBtn').addEventListener('click', processTikTokLink);
        document.getElementById('urlInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') processTikTokLink();
        });

        async function processTikTokLink() {
            const url = document.getElementById('urlInput').value.trim();
            const processBtn = document.getElementById('processBtn');
            const loadingState = document.getElementById('loadingState');
            const errorState = document.getElementById('errorState');
            const progressBar = document.getElementById('progressBar');
            const loadingText = document.getElementById('loadingText');

            // Validation
            if (!url) {
                showToast('warning', 'Link Kosong', 'Masukkan link TikTok terlebih dahulu');
                shakeInput();
                return;
            }

            if (!isTikTokUrl(url)) {
                showToast('error', 'Link Tidak Valid', 'Pastikan link yang dimasukkan adalah link TikTok');
                shakeInput();
                return;
            }

            // Start processing
            processBtn.disabled = true;
            processBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Memproses...</span>';
            loadingState.classList.add('active');
            errorState.classList.remove('active');
            progressBar.style.width = '0%';

            // Animate progress
            let progress = 0;
            const loadingMessages = [
                'Menganalisis link TikTok...',
                'Mengambil data video...',
                'Memproses tanpa watermark...',
                'Menyiapkan link download...',
                'Hampir selesai...'
            ];

            const progressInterval = setInterval(() => {
                progress += Math.random() * 8 + 2;
                if (progress > 90) progress = 90;
                progressBar.style.width = `${progress}%`;
                
                const msgIndex = Math.min(Math.floor(progress / 20), loadingMessages.length - 1);
                loadingText.textContent = loadingMessages[msgIndex];
            }, 200);

            try {
                const data = await fetchTikTokData(url);

                clearInterval(progressInterval);
                progressBar.style.width = '100%';
                loadingText.textContent = 'Selesai!';

                if (!data) throw new Error('Gagal mengambil data video');

                // Store data
                currentVideoData = data;

                // Update result page
                document.getElementById('resultThumb').src = data.thumbnail || '';
                document.getElementById('resultTitle').textContent = data.title || 'Video TikTok';
                document.getElementById('resultAuthor').textContent = data.author || '@unknown';
                document.getElementById('resultLikes').textContent = formatNumber(data.likes || 0);
                document.getElementById('resultDuration').textContent = formatDuration(data.duration || 0);

                // Set download links
                document.getElementById('dlHd').href = data.video_hd || '#';
                document.getElementById('dlSd').href = data.video_sd || data.video_hd || '#';
                document.getElementById('dlAudio').href = data.audio || '#';
                document.getElementById('dlCover').href = data.thumbnail || '#';

                // Save to history
                saveToHistory(data);
                downloadCount++;
                localStorage.setItem('totalDownloads', downloadCount);
                updateDownloadCount();

                // Transition to result
                setTimeout(() => {
                    loadingState.classList.remove('active');
                    showPage('result');
                    showToast('success', 'Berhasil!', 'Video siap untuk didownload');
                    createConfetti();
                }, 500);

            } catch (error) {
                clearInterval(progressInterval);
                loadingState.classList.remove('active');
                errorState.classList.add('active');
                document.getElementById('errorText').textContent = error.message || 'Gagal memproses video. Coba lagi.';
                showToast('error', 'Gagal', error.message || 'Terjadi kesalahan');
            } finally {
                processBtn.disabled = false;
                processBtn.innerHTML = '<i class="fas fa-download"></i> <span>Download Sekarang</span>';
            }
        }

        // ====== API FETCHING ======
        async function fetchTikTokData(url) {
            const apis = [
                {
                    url: `https://tikwm.com/api/?url=${encodeURIComponent(url)}&hd=1`,
                    parse: (json) => {
                        if (json.code !== 0) return null;
                        const d = json.data;
                        return {
                            video_hd: d.hdplay || d.play,
                            video_sd: d.play || d.wmplay,
                            audio: d.music,
                            thumbnail: d.cover || d.origin_cover,
                            title: d.title || 'Video TikTok',
                            author: d.author?.unique_id || d.author?.nickname || '@unknown',
                            likes: d.digg_count || 0,
                            duration: d.duration || 0
                        };
                    }
                },
                {
                    url: `https://www.tikwm.com/api/?url=${encodeURIComponent(url)}&hd=1`,
                    parse: (json) => {
                        if (json.code !== 0) return null;
                        const d = json.data;
                        return {
                            video_hd: d.hdplay || d.play,
                            video_sd: d.play || d.wmplay,
                            audio: d.music,
                            thumbnail: d.cover || d.origin_cover,
                            title: d.title || 'Video TikTok',
                            author: d.author?.unique_id || d.author?.nickname || '@unknown',
                            likes: d.digg_count || 0,
                            duration: d.duration || 0
                        };
                    }
                }
            ];

            for (const api of apis) {
                try {
                    const res = await fetch(api.url, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });
                    const json = await res.json();
                    const data = api.parse(json);
                    if (data && data.video_hd) return data;
                } catch (e) {
                    console.log('API failed:', api.url, e.message);
                    continue;
                }
            }

            throw new Error('Semua server sedang sibuk. Coba beberapa saat lagi.');
        }

        // ====== DOWNLOAD HANDLER ======
        function handleDownload(event, type) {
            event.preventDefault();
            
            const link = event.currentTarget;
            const href = link.href;
            
            if (!href || href === '#') {
                showToast('error', 'Link Tidak Tersedia', 'Format download ini tidak tersedia untuk video ini');
                return;
            }

            const typeNames = {
                hd: 'Video HD (No Watermark)',
                sd: 'Video SD',
                audio: 'Audio MP3',
                cover: 'Cover Image'
            };

            const fileNames = {
                hd: `tiktok_video_hd_${Date.now()}.mp4`,
                sd: `tiktok_video_sd_${Date.now()}.mp4`,
                audio: `tiktok_audio_${Date.now()}.mp3`,
                cover: `tiktok_cover_${Date.now()}.jpg`
            };

            // Show download notification
            showDownloadNotification(
                fileNames[type],
                typeNames[type],
                currentVideoData?.thumbnail
            );

            // Show toast
            showToast('download', 'Download Dimulai', `Mengunduh ${typeNames[type]}...`);

            // Trigger actual download
            triggerDownload(href, fileNames[type]);
        }

        function triggerDownload(url, filename) {
            // Create invisible link for download
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            
            // For cross-origin downloads, try fetch + blob approach
            fetch(url)
                .then(response => {
                    if (!response.ok) throw new Error('Network error');
                    return response.blob();
                })
                .then(blob => {
                    const blobUrl = URL.createObjectURL(blob);
                    const downloadLink = document.createElement('a');
                    downloadLink.href = blobUrl;
                    downloadLink.download = filename;
                    document.body.appendChild(downloadLink);
                    downloadLink.click();
                    document.body.removeChild(downloadLink);
                    URL.revokeObjectURL(blobUrl);
                })
                .catch(err => {
                    // Fallback: open in new tab
                    console.log('Blob download failed, using fallback:', err);
                    window.open(url, '_blank');
                });
        }

        // ====== VIDEO PREVIEW ======
        function playPreview() {
            if (!currentVideoData) return;
            const modal = document.getElementById('videoModal');
            const video = document.getElementById('modalVideo');
            video.src = currentVideoData.video_sd || currentVideoData.video_hd;
            modal.classList.add('active');
        }

        function closeVideoModal() {
            const modal = document.getElementById('videoModal');
            const video = document.getElementById('modalVideo');
            video.pause();
            video.src = '';
            modal.classList.remove('active');
        }

        document.getElementById('videoModal').addEventListener('click', (e) => {
            if (e.target === e.currentTarget) closeVideoModal();
        });

        // ====== HISTORY ======
        function saveToHistory(data) {
            const history = JSON.parse(localStorage.getItem('downloadHistory') || '[]');
            history.unshift({
                title: data.title,
                author: data.author,
                thumbnail: data.thumbnail,
                date: new Date().toISOString(),
                url: data.video_hd
            });
            localStorage.setItem('downloadHistory', JSON.stringify(history.slice(0, 20)));
            renderHistory();
        }

        function renderHistory() {
            const history = JSON.parse(localStorage.getItem('downloadHistory') || '[]');
            const container = document.getElementById('historyList');

            if (history.length === 0) {
                container.innerHTML = `
                    <div class="history-empty">
                        <i class="fas fa-inbox"></i>
                        <p>Belum ada riwayat download</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = history.slice(0, 5).map(item => `
                <div class="history-item">
                    <div class="history-thumb">
                        <img src="${item.thumbnail || ''}" alt="" onerror="this.style.display='none'">
                    </div>
                    <div class="history-info">
                        <h5>${item.title || 'Video TikTok'}</h5>
                        <span>${item.author || ''} • ${timeAgo(item.date)}</span>
                    </div>
                </div>
            `).join('');
        }

        function updateDownloadCount() {
            document.getElementById('totalDownloads').textContent = downloadCount.toLocaleString();
        }

        // ====== UTILITIES ======
        function shakeInput() {
            const wrapper = document.querySelector('.input-wrapper');
            wrapper.style.animation = 'shakeError 0.5s ease';
            setTimeout(() => wrapper.style.animation = '', 500);
        }

        function formatNumber(num) {
            if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
            if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
            return num.toString();
        }

        function formatDuration(seconds) {
            const m = Math.floor(seconds / 60);
            const s = seconds % 60;
            return `${m}:${s.toString().padStart(2, '0')}`;
        }

        function timeAgo(dateStr) {
            const now = new Date();
            const date = new Date(dateStr);
            const diff = Math.floor((now - date) / 1000);
            
            if (diff < 60) return 'Baru saja';
            if (diff < 3600) return `${Math.floor(diff / 60)} menit lalu`;
            if (diff < 86400) return `${Math.floor(diff / 3600)} jam lalu`;
            return `${Math.floor(diff / 86400)} hari lalu`;
        }

        function toggleFaq(el) {
            const item = el.parentElement;
            const wasOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
            if (!wasOpen) item.classList.add('open');
        }

        function rotatePlaceholder() {
            const placeholders = [
                'https://www.tiktok.com/@user/video/1234567890',
                'https://vm.tiktok.com/ZMxxxxxxx/',
                'Paste link TikTok di sini...',
                'https://vt.tiktok.com/ZSxxxxxx/'
            ];
            let idx = 0;
            const input = document.getElementById('urlInput');
            
            setInterval(() => {
                if (!input.value && document.activeElement !== input) {
                    input.placeholder = placeholders[idx];
                    idx = (idx + 1) % placeholders.length;
                }
            }, 3000);
        }

        // ====== CONFETTI EFFECT ======
        function createConfetti() {
            const colors = ['#ff0050', '#00f2ea', '#7c3aed', '#f59e0b', '#10b981'];
            for (let i = 0; i < 30; i++) {
                const confetti = document.createElement('div');
                confetti.className = 'confetti-piece';
                confetti.style.left = Math.random() * 100 + 'vw';
                confetti.style.top = '-10px';
                confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
                confetti.style.width = Math.random() * 8 + 4 + 'px';
                confetti.style.height = Math.random() * 8 + 4 + 'px';
                confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
                confetti.style.transform = `rotate(${Math.random() * 360}deg)`;
                
                document.body.appendChild(confetti);

                const animation = confetti.animate([
                    { transform: `translateY(0) rotate(0deg)`, opacity: 1 },
                    { transform: `translateY(100vh) rotate(${Math.random() * 720}deg)`, opacity: 0 }
                ], {
                    duration: Math.random() * 2000 + 1500,
                    easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)'
                });

                animation.onfinish = () => confetti.remove();
            }
        }

        // ====== HISTORY BUTTON ======
        document.getElementById('historyBtn').addEventListener('click', () => {
            const section = document.getElementById('historySection');
            section.scrollIntoView({ behavior: 'smooth' });
        });

        // ====== KEYBOARD SHORTCUTS ======
        document.addEventListener('keydown', (e) => {
            // Ctrl+V auto-focus input
            if ((e.ctrlKey || e.metaKey) && e.key === 'v') {
                const input = document.getElementById('urlInput');
                if (document.activeElement !== input) {
                    input.focus();
                }
            }
            // Escape to close modal
            if (e.key === 'Escape') {
                closeVideoModal();
            }
        });
    </script>
</body>
</html>
